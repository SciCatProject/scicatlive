## Choose between the legacy backend and the current one [v3, v4]
# BE_VERSION=v3

## Enable JOBS feature (disable if required or set in command line). To later disable, either unset or set to an empty value
# JOBS_ENABLED=true

## Enable v4 OPENSEARCH feature (disable if required or set in command line). To later disable, either unset or set to an empty value
# OPENSEARCH_ENABLED=true

## Enable LDAP authentication backend (disable if required or set in command line). To later disable, either unset or set to an empty value
# LDAP_ENABLED=true

## Enable OIDC authentication backend (disable if required or set in command line). To later disable, either unset or set to an empty value
# OIDC_ENABLED=true

## Run SciCat services in DEV mode
# DEV=true

## Run individual services in DEV mode (by default setting DEV=true starts every compatible services in DEV mode)
# BACKEND_DEV=true
# FRONTEND_DEV=true
# LANDINGPAGE_DEV=true
# OAIPMH_DEV=true
# SEARCHAPI_DEV=true
# SCICATLIVE_DEV=true
# USER_DOCS_DEV=true

## In addition to DEV=true, it enables bidirectional synchronization between ${PWD}/bbackup/${APP} on the host and the dev volume
# DEV_BBACKUP=true

## Set the services HTTPS URL; override to point at your own domain, e.g. https://backend-example.com
# BACKEND_HTTPS_URL=https://backend-example.com
# FRONTEND_HTTPS_URL=https://frontend-example.com
# KEYCLOAK_HTTPS_URL=https://keycloak-example.com

## -----------------------------------------------------------------------------------------------------------------
## Computed from the options above - not meant to be edited directly. Compose files read these `_`-prefixed vars
## instead of the raw options above, so that e.g. BACKEND_DEV can be left unset and still fall back to DEV.
## -----------------------------------------------------------------------------------------------------------------
_BE_VERSION=${BE_VERSION:-v4}
_BACKEND_DEV=${DEV:-${BACKEND_DEV:-}}
_FRONTEND_DEV=${DEV:-${FRONTEND_DEV:-}}
_LANDINGPAGE_DEV=${DEV:-${LANDINGPAGE_DEV:-}}
_OAIPMH_DEV=${DEV:-${OAIPMH_DEV:-}}
_SEARCHAPI_DEV=${DEV:-${SEARCHAPI_DEV:-}}
_SCICATLIVE_DEV=${DEV:-${SCICATLIVE_DEV:-}}
_USER_DOCS_DEV=${DEV:-${USER_DOCS_DEV:-}}
_BACKEND_HTTPS_URL=${BACKEND_HTTPS_URL:-http://backend.localhost}
_FRONTEND_HTTPS_URL=${FRONTEND_HTTPS_URL:-http://localhost}
_KEYCLOAK_HTTPS_URL=${KEYCLOAK_HTTPS_URL:-http://keycloak.localhost}
