{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "ignorePaths": [
    "services/frontend/compose.v3.yaml",
    "services/searchapi/compose.v3.yaml",
    "services/backend/services/rabbitmq/compose.v3.yaml"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "reviewers": []
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/compose\\.lint\\.yaml$"],
      "matchStrings": [
        "(?<depName>ghcr\\.io/catthehacker/ubuntu):act-(?<currentValue>\\d+\\.\\d+-\\d{8})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    }
  ]
}
