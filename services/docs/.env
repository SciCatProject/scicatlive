BACKEND_DEV=${DEV:-${BACKEND_DEV:-}}
FRONTEND_DEV=${DEV:-${FRONTEND_DEV:-}}
SCICATLIVE_DEV=${DEV:-${SCICATLIVE_DEV:-}}

## True whenever any of the above is set, so compose.base.yaml (and therefore the docs service) is only pulled in
## when at least one mount would actually be enabled.
DOCS_DEV=${BACKEND_DEV:-${FRONTEND_DEV:-${SCICATLIVE_DEV:-}}}
